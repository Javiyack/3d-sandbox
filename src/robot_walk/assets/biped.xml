<mujoco model="biped_walker">
  <compiler angle="radian" coordinate="local"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4" iterations="50" tolerance="1e-8"/>

  <default>
    <geom condim="3" friction="1.4 0.4 0.02" contype="1" conaffinity="1"
          solref="0.002 1" solimp="0.9 0.95 0.001"/>
    <joint damping="1.2" armature="0.02" frictionloss="0.02"/>
  </default>

  <worldbody>
    <light name="top" pos="0 0 4" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="ground" type="plane" size="20 20 0.1" rgba="0.75 0.78 0.82 1"/>

    <body name="torso" pos="0 0 1.05">
      <freejoint name="root"/>
      <geom name="pelvis" type="box" size="0.18 0.13 0.12" mass="5.0" rgba="0.20 0.45 0.80 1"/>
      <geom name="upper_torso" type="box" size="0.20 0.14 0.16" pos="0 0 0.20" mass="4.0" rgba="0.20 0.55 0.90 1"/>
      <geom name="head" type="sphere" size="0.10" pos="0 0 0.43" mass="1.0" rgba="0.90 0.72 0.55 1"/>

      <body name="left_hip" pos="-0.13 0 -0.20">
        <joint name="left_hip_yaw" type="hinge" axis="0 0 1" range="-0.45 0.45"/>
        <joint name="left_hip_roll" type="hinge" axis="1 0 0" range="-0.55 0.55"/>
        <joint name="left_hip_pitch" type="hinge" axis="0 1 0" range="-1.20 1.20"/>
        <geom name="left_thigh" type="capsule" fromto="0 0 0 0 0 -0.34" size="0.055" mass="1.20"
              rgba="0.24 0.70 0.45 1"/>

        <body name="left_shin" pos="0 0 -0.34">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="-0.10 2.10"/>
          <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.34" size="0.045" mass="0.85"
                rgba="0.20 0.62 0.38 1"/>

          <body name="left_ankle" pos="0 0 -0.34">
            <joint name="left_ankle_roll" type="hinge" axis="1 0 0" range="-0.50 0.50"/>
            <joint name="left_ankle_pitch" type="hinge" axis="0 1 0" range="-0.80 0.80"/>
            <body name="left_foot" pos="0.05 0 -0.02">
              <geom name="left_foot_geom" type="box" size="0.16 0.09 0.025" mass="0.40"
                    rgba="0.18 0.18 0.20 1"/>
            </body>
          </body>
        </body>
      </body>

      <body name="right_hip" pos="0.13 0 -0.20">
        <joint name="right_hip_yaw" type="hinge" axis="0 0 1" range="-0.45 0.45"/>
        <joint name="right_hip_roll" type="hinge" axis="1 0 0" range="-0.55 0.55"/>
        <joint name="right_hip_pitch" type="hinge" axis="0 1 0" range="-1.20 1.20"/>
        <geom name="right_thigh" type="capsule" fromto="0 0 0 0 0 -0.34" size="0.055" mass="1.20"
              rgba="0.24 0.70 0.45 1"/>

        <body name="right_shin" pos="0 0 -0.34">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="-0.10 2.10"/>
          <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.34" size="0.045" mass="0.85"
                rgba="0.20 0.62 0.38 1"/>

          <body name="right_ankle" pos="0 0 -0.34">
            <joint name="right_ankle_roll" type="hinge" axis="1 0 0" range="-0.50 0.50"/>
            <joint name="right_ankle_pitch" type="hinge" axis="0 1 0" range="-0.80 0.80"/>
            <body name="right_foot" pos="0.05 0 -0.02">
              <geom name="right_foot_geom" type="box" size="0.16 0.09 0.025" mass="0.40"
                    rgba="0.18 0.18 0.20 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_hip_yaw" joint="left_hip_yaw" gear="35"/>
    <motor name="left_hip_roll" joint="left_hip_roll" gear="55"/>
    <motor name="left_hip_pitch" joint="left_hip_pitch" gear="65"/>
    <motor name="left_knee" joint="left_knee" gear="55"/>
    <motor name="left_ankle_roll" joint="left_ankle_roll" gear="25"/>
    <motor name="left_ankle_pitch" joint="left_ankle_pitch" gear="25"/>

    <motor name="right_hip_yaw" joint="right_hip_yaw" gear="35"/>
    <motor name="right_hip_roll" joint="right_hip_roll" gear="55"/>
    <motor name="right_hip_pitch" joint="right_hip_pitch" gear="65"/>
    <motor name="right_knee" joint="right_knee" gear="55"/>
    <motor name="right_ankle_roll" joint="right_ankle_roll" gear="25"/>
    <motor name="right_ankle_pitch" joint="right_ankle_pitch" gear="25"/>
  </actuator>
</mujoco>
